<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">蓝牙信号探测器</string>
    <string name="subtitle">扫描附近的蓝牙设备，点击设备追踪信号强度，长按可重命名</string>
    <string name="start_scan">开始扫描</string>
    <string name="stop_scan">停止扫描</string>
    <string name="empty_scanning">正在搜索附近蓝牙设备…\n请确保丢失的设备已开机（处于广播状态）</string>
    <string name="empty_stopped">扫描已停止</string>
    <string name="unknown_device">未知设备</string>
    <string name="classic_tag">经典蓝牙</string>
    <string name="back_to_list">← 返回设备列表</string>
    <string name="rename">重命名</string>
    <string name="rename_title">重命名设备</string>
    <string name="rename_hint">自定义名称</string>
    <string name="clear_name">清除命名</string>
    <string name="calibrate">📏 校准</string>
    <string name="calibrate_title">1 米校准</string>
    <string name="calibrate_msg">把手机举到离设备约 1 米（一大步）的位置并保持不动，应用将采样 3 秒信号。校准后，这台设备的距离估算会比通用默认值准确得多。</string>
    <string name="calibrate_start">开始校准</string>
    <string name="calibrating">校准中…</string>
    <string name="calibrate_done">校准完成：1 米 ≈ %1$d dBm，该设备的距离估算已更准确。</string>
    <string name="calibrate_failed">信号太弱或不稳定，请离设备更近一些再试。</string>
    <string name="compass">🧭 方向</string>
    <string name="trail">🗺 轨迹</string>
    <string name="compass_hint">把手机平贴在胸口、屏幕朝外，然后原地缓慢转一整圈。身体会挡住身后的信号，因此信号最强的朝向就是设备所在方向。白色小三角是你当前面朝的方向——转动身体让它对准绿色箭头即可。</string>
    <string name="compass_none">暂无采样，开始缓慢转圈</string>
    <string name="compass_coverage">已采样 %1$d/24 个方向，继续转…</string>
    <string name="compass_result_high">信号最强朝向：%1$s（置信度高）</string>
    <string name="compass_result_low">最强朝向：%1$s（置信度低，可能有反射，建议再转一圈）</string>
    <string name="compass_reset">🔄 重新采样</string>
    <string name="trail_hint">像平时看手机一样竖屏手持，正常走动即可。走过的路径会按信号强弱染色——绿色最深的路段就是离设备最近的位置。</string>
    <string name="trail_clear">🗑 清空</string>
    <string name="close">关闭</string>
    <string name="dir_north">北方</string>
    <string name="dir_northeast">东北方</string>
    <string name="dir_east">东方</string>
    <string name="dir_southeast">东南方</string>
    <string name="dir_south">南方</string>
    <string name="dir_southwest">西南方</string>
    <string name="dir_west">西方</string>
    <string name="dir_northwest">西北方</string>
    <string name="waiting_signal">等待信号…</string>
    <string name="rssi_value">%1$d dBm</string>
    <string name="distance_fmt">估计距离约 %1$s 米（%2$s）</string>
    <string name="zone_very_near">非常接近，就在脚下</string>
    <string name="zone_near">比较近</string>
    <string name="zone_medium">中等距离</string>
    <string name="zone_far">较远或隔墙</string>
    <string name="trend_closer">↑ 越来越近</string>
    <string name="trend_farther">↓ 越来越远</string>
    <string name="trend_stable">→ 信号稳定</string>
    <string name="vibrate_option">靠近时震动</string>
    <string name="beep_option">蜂鸣提示（越近响得越快，不用盯屏幕）</string>
    <string name="tips">寻找技巧：\n· 缓慢移动，每次半米停两秒，看趋势箭头再决定方向\n· 信号每增强约 6 dBm，距离大约减半\n· 慢慢转动手机朝向，某个方向信号会明显更强\n· 隔墙、金属和人体遮挡都会大幅衰减信号\n· 估计距离为粗略推算，以趋势和分档为准</string>
    <string name="permission_denied">需要蓝牙权限才能扫描，请在系统设置中授予后重试</string>
    <string name="location_needed_title">需要开启位置服务</string>
    <string name="location_needed_msg">Android 11 及以下系统要求开启位置服务才能扫描蓝牙设备（本应用不会获取你的位置信息）。</string>
    <string name="go_settings">去开启</string>
    <string name="no_bluetooth">此手机不支持蓝牙</string>
</resources>
